{
  "name": "@zeiq/locca",
  "version": "2.0.0",
  "description": "Persistent local AI workspaces powered by Eve and llama.cpp",
  "type": "module",
  "bin": {
    "locca": "bin/locca"
  },
  "files": [
    "bin",
    "dist",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    ".output",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:cli && npm run build:agent",
    "dev": "tsc --watch",
    "start": "node bin/locca",
    "site": "python3 -m http.server 8765 --bind 127.0.0.1 --directory docs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "pretest": "npm run build",
    "test": "node --test test/unit/*.test.js",
    "prepublishOnly": "npm run build",
    "release": "npm publish --access=public",
    "build:cli": "tsc",
    "build:agent": "EVE_TELEMETRY_DISABLED=1 eve build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.agent.json",
    "test:integration": "node --test test/integration/*.test.js"
  },
  "keywords": [
    "llama.cpp",
    "llm",
    "tui",
    "cli",
    "gguf",
    "huggingface",
    "eve",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perminder-klair/locca.git"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.45",
    "@clack/prompts": "^0.8.2",
    "@inquirer/search": "^3.0.0",
    "ai": "7.0.94",
    "eve": "0.52.3",
    "picocolors": "^1.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
